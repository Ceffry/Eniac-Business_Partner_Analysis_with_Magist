    <worksheet name='Revenue by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Tech vs Top 8 Non-Tech Categories by Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders+' name='federated.0cis6ar1u3jtca1bcrjf90p7a3kh' />
          </datasources>
          <datasource-dependencies datasource='federated.0cis6ar1u3jtca1bcrjf90p7a3kh'>
            <column caption='Revenue All Sellers' datatype='real' name='[Calculation_1518733548687372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(FLOAT([price]))' />
            </column>
            <column caption='Tech Category' datatype='string' name='[Calculation_1518733578760210]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [product_category_name_english] IN (&#13;&#10;    &quot;audio&quot;,&#13;&#10;    &quot;consoles_games&quot;,&#13;&#10;    &quot;electronics&quot;,&#13;&#10;    &quot;computers_accessories&quot;,&#13;&#10;    &quot;pc_gamer&quot;,&#13;&#10;    &quot;computers&quot;,&#13;&#10;    &quot;tablets_printing_image&quot;,&#13;&#10;    &quot;telephony&quot;&#13;&#10;)&#13;&#10;THEN &quot;Tech&quot;&#13;&#10;ELSE &quot;Non-Tech&quot;&#13;&#10;END' />
            </column>
            <column caption='Category Display Name' datatype='string' name='[Calculation_1518733600100385]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [product_category_name_english]&#13;&#10;&#13;&#10;WHEN &quot;computers_accessories&quot; THEN &quot;Computer Accessories&quot;&#13;&#10;WHEN &quot;tablets_printing_image&quot; THEN &quot;Tablets &amp; Printing&quot;&#13;&#10;WHEN &quot;consoles_games&quot; THEN &quot;Consoles &amp; Games&quot;&#13;&#10;WHEN &quot;pc_gamer&quot; THEN &quot;PC Gamer&quot;&#13;&#10;WHEN &quot;electronics&quot; THEN &quot;Electronics&quot;&#13;&#10;WHEN &quot;telephony&quot; THEN &quot;Telephony&quot;&#13;&#10;WHEN &quot;audio&quot; THEN &quot;Audio&quot;&#13;&#10;WHEN &quot;computers&quot; THEN &quot;Computers&quot;&#13;&#10;WHEN &quot;health_beauty&quot; THEN &quot;Health &amp; Beauty&quot;&#13;&#10;WHEN &quot;watches_gifts&quot; THEN &quot;Watches &amp; Gifts&quot;&#13;&#10;WHEN &quot;bed_bath_table&quot; THEN &quot;Bed &amp; Bath&quot;&#13;&#10;WHEN &quot;sports_leisure&quot; THEN &quot;Sports &amp; Leisure&quot;&#13;&#10;WHEN &quot;furniture_decor&quot; THEN &quot;Furniture &amp; Decor&quot;&#13;&#10;WHEN &quot;cool_stuff&quot; THEN &quot;Cool Stuff&quot;&#13;&#10;WHEN &quot;hoursewares&quot; THEN &quot;Housewares&quot;&#13;&#10;WHEN &quot;auto&quot; THEN &quot;Auto&quot;&#13;&#10;&#13;&#10;ELSE [product_category_name_english]&#13;&#10;&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1518733578760210]' derivation='None' name='[none:Calculation_1518733578760210:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1518733600100385]' derivation='None' name='[none:Calculation_1518733600100385:nk]' pivot='key' type='nominal' />
            <column caption='Price' datatype='string' name='[price]' role='dimension' type='nominal' />
            <column caption='Product Category Name English' datatype='string' name='[product_category_name_english]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1518733548687372]' derivation='User' name='[usr:Calculation_1518733548687372:qk]' pivot='key' type='quantitative' />
