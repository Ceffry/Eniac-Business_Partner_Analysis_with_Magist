      <aliases enabled='yes' />
      <column caption='total orders' datatype='integer' name='[Calculation_1518733452185600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([order_delivered_customer_date])&#13;&#10;       AND NOT ISNULL([order_estimated_delivery_date])&#13;&#10;    THEN [order_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Delayed Orders' datatype='integer' name='[Calculation_1518733452394497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#13;&#10;    THEN [order_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='On-Time Orders' datatype='integer' name='[Calculation_1518733452496898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1518733452185600] - [Calculation_1518733452394497]' />
      </column>
      <column caption='Delivery StatusIF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN    &quot;Delayed&quot;ELSE    &quot;On Time&quot;END' datatype='string' name='[Calculation_1518733453729795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN&#13;&#10;    &quot;Delayed&quot;&#13;&#10;ELSE&#13;&#10;    &quot;On Time&quot;&#13;&#10;END' />
      </column>
      <column caption='Dummy Field' datatype='real' name='[Calculation_1518733459390469]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(0)' />
      </column>
      <column caption='Company Processing' datatype='integer' name='[Calculation_1518733472325638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [order_purchase_timestamp],&#13;&#10;    [order_approved_at]&#13;&#10;)' />
      </column>
      <column caption='Carrier Processing' datatype='integer' name='[Calculation_1518733472428039]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [order_approved_at],&#13;&#10;    [order_delivered_carrier_date]&#13;&#10;)' />
      </column>
      <column caption='Delivery to Customer' datatype='integer' name='[Calculation_1518733472477192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [order_delivered_carrier_date],&#13;&#10;    [order_delivered_customer_date]&#13;&#10;)' />
      </column>
      <column caption='Tech Sellers' datatype='integer' name='[Calculation_1518733517946889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [product_category_name] IN (&#13;&#10;        &quot;telefonia&quot;,&#13;&#10;        &quot;tablets_impressao_imagem&quot;,&#13;&#10;        &quot;pcs&quot;,&#13;&#10;        &quot;informatica_acessorios&quot;,&#13;&#10;        &quot;audio&quot;,&#13;&#10;        &quot;eletronicos&quot;,&#13;&#10;        &quot;consoles_games&quot;,&#13;&#10;        &quot;pc_gamer&quot;&#13;&#10;    )&#13;&#10;    THEN [seller_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Revenue All Sellers' datatype='real' name='[Calculation_1518733548687372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(FLOAT([price]))' />
      </column>
      <column caption='Revenue Tech Sellers' datatype='real' name='[Calculation_1518733549281293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [product_category_name] IN (&#13;&#10;        &quot;telefonia&quot;,&#13;&#10;        &quot;tablets_impressao_imagem&quot;,&#13;&#10;        &quot;pcs&quot;,&#13;&#10;        &quot;informatica_acessorios&quot;,&#13;&#10;        &quot;audio&quot;,&#13;&#10;        &quot;eletronicos&quot;,&#13;&#10;        &quot;consoles_games&quot;,&#13;&#10;        &quot;pc_gamer&quot;&#13;&#10;    )&#13;&#10;    THEN FLOAT([price])&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Tech Revenue %' datatype='real' default-format='p0%' name='[Calculation_1518733549592590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [product_category_name] IN (&#13;&#10;        &quot;telefonia&quot;,&#13;&#10;        &quot;tablets_impressao_imagem&quot;,&#13;&#10;        &quot;pcs&quot;,&#13;&#10;        &quot;informatica_acessorios&quot;,&#13;&#10;        &quot;audio&quot;,&#13;&#10;        &quot;eletronicos&quot;,&#13;&#10;        &quot;consoles_games&quot;,&#13;&#10;        &quot;pc_gamer&quot;&#13;&#10;    )&#13;&#10;    THEN FLOAT([price])&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(FLOAT([price]))' />
      </column>
      <column caption='All Sellers' datatype='integer' name='[Calculation_1518733550899215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([seller_id])' />
      </column>
      <column caption='Tech Category' datatype='string' name='[Calculation_1518733578760210]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [product_category_name_english] IN (&#13;&#10;    &quot;audio&quot;,&#13;&#10;    &quot;consoles_games&quot;,&#13;&#10;    &quot;electronics&quot;,&#13;&#10;    &quot;computers_accessories&quot;,&#13;&#10;    &quot;pc_gamer&quot;,&#13;&#10;    &quot;computers&quot;,&#13;&#10;    &quot;tablets_printing_image&quot;,&#13;&#10;    &quot;telephony&quot;&#13;&#10;)&#13;&#10;THEN &quot;Tech&quot;&#13;&#10;ELSE &quot;Non-Tech&quot;&#13;&#10;END' />
      </column>
      <column caption='Non-Tech Revenue' datatype='string' name='[Calculation_1518733587951637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1518733578760210] = &quot;Non-Tech&quot;&#13;&#10;THEN [price]&#13;&#10;END' />
      </column>
      <column caption='Top 8 Category' datatype='boolean' name='[Calculation_1518733590454295]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(SUM(FLOAT([price])), &apos;desc&apos;) &lt;= 8'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Revenue' datatype='real' name='[Calculation_1518733592010776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_category_name_english] :&#13;&#10;    SUM(FLOAT([price]))&#13;&#10;}' />
      </column>
      <column caption='Tech Category Revenue' datatype='real' name='[Calculation_1518733592129561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [product_category_name_english] :&#13;&#10;    SUM(&#13;&#10;        IF [Calculation_1518733578760210] = &quot;Tech&quot;&#13;&#10;        THEN FLOAT([price])&#13;&#10;        ELSE 0&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Category Rank' datatype='integer' name='[Calculation_1518733592289306]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(&#13;&#10;    SUM(FLOAT([price])),&#13;&#10;    &apos;desc&apos;&#13;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Display Name' datatype='string' name='[Calculation_1518733600100385]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [product_category_name_english]&#13;&#10;&#13;&#10;WHEN &quot;computers_accessories&quot; THEN &quot;Computer Accessories&quot;&#13;&#10;WHEN &quot;tablets_printing_image&quot; THEN &quot;Tablets &amp; Printing&quot;&#13;&#10;WHEN &quot;consoles_games&quot; THEN &quot;Consoles &amp; Games&quot;&#13;&#10;WHEN &quot;pc_gamer&quot; THEN &quot;PC Gamer&quot;&#13;&#10;WHEN &quot;electronics&quot; THEN &quot;Electronics&quot;&#13;&#10;WHEN &quot;telephony&quot; THEN &quot;Telephony&quot;&#13;&#10;WHEN &quot;audio&quot; THEN &quot;Audio&quot;&#13;&#10;WHEN &quot;computers&quot; THEN &quot;Computers&quot;&#13;&#10;WHEN &quot;health_beauty&quot; THEN &quot;Health &amp; Beauty&quot;&#13;&#10;WHEN &quot;watches_gifts&quot; THEN &quot;Watches &amp; Gifts&quot;&#13;&#10;WHEN &quot;bed_bath_table&quot; THEN &quot;Bed &amp; Bath&quot;&#13;&#10;WHEN &quot;sports_leisure&quot; THEN &quot;Sports &amp; Leisure&quot;&#13;&#10;WHEN &quot;furniture_decor&quot; THEN &quot;Furniture &amp; Decor&quot;&#13;&#10;WHEN &quot;cool_stuff&quot; THEN &quot;Cool Stuff&quot;&#13;&#10;WHEN &quot;hoursewares&quot; THEN &quot;Housewares&quot;&#13;&#10;WHEN &quot;auto&quot; THEN &quot;Auto&quot;&#13;&#10;&#13;&#10;ELSE [product_category_name_english]&#13;&#10;&#13;&#10;END' />
      </column>
